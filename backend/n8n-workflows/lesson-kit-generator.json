        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\"model\": \"deepseek/deepseek-chat\", \"messages\": [{\"role\": \"system\", \"content\": \"You are an expert curriculum designer and teacher. Generate complete lesson kits aligned to the specified curriculum. Return only valid JSON.\"}, {\"role\": \"user\", \"content\": \"Generate a complete lesson kit.\\n\\nSubject: \" + $json.subject + \"\\nGrade: \" + $json.grade + \"\\nTopic: \" + $json.topic + \"\\nDuration: \" + $json.duration + \"\\nLanguage: \" + $json.language + \"\\nCurriculum: \" + $json.curriculum + \"\\n\\nAlign all content to the selected curriculum.\\n\\nReturn valid JSON only.\\n\\n{\\n  \\\"lesson_plan\\\": {\\n    \\\"warm_up\\\": \\\"\\\",\\n    \\\"concept\\\": \\\"\\\",\\n    \\\"activity\\\": \\\"\\\",\\n    \\\"homework\\\": \\\"\\\"\\n  },\\n  \\\"learning_outcomes\\\": [\\n    \\\"\\\"\\n  ],\\n  \\\"competencies\\\": [\\n    \\\"\\\"\\n  ],\\n  \\\"worksheet\\\": {\\n    \\\"questions\\\": []\\n  },\\n  \\\"quiz\\\": {\\n    \\\"mcqs\\\": []\\n  },\\n  \\\"answer_key\\\": {\\n    \\\"answers\\\": []\\n  }\\n}\\n\\nRequirements:\\n* Grade appropriate\\n* Curriculum aligned\\n* Classroom ready\\n* Teacher friendly\\n\\nReturn JSON only.\"}]} }}",
        "options": {}

    {
      "parameters": {
        "jsCode": "let raw = $input.first().json.ai_text;\n\n// Clean markdown code blocks if present\nraw = raw\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\ntry {\n  const parsed = JSON.parse(raw);\n  \n  return [\n    {\n      json: {\n        success: true,\n        lesson: parsed\n      }\n    }\n  ];\n} catch (error) {\n  return [\n    {\n      json: {\n        success: false,\n        error: \"Invalid JSON from AI: \" + error.message,\n        raw_response: raw\n      }\n    }\n  ];\n}"
      },
